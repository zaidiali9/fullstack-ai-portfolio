# ---------------------------------------------------------------------------
# Bookwell (apps/booking) — copy to .env and adjust. Never commit .env.
# Every variable is optional for local development unless marked REQUIRED.
# ---------------------------------------------------------------------------

# Public base URL of the app (auth callbacks, canonical URLs, sitemap). Must match the URL in the browser.
APP_URL=http://localhost:3004

# Database. Leave empty to use the embedded PGlite database in .data/pglite (no Docker needed).
# For Postgres (docker-compose, Neon, Supabase) set a connection string. The migration enables the
# btree_gist extension (bundled with standard Postgres) for the no-double-booking constraint.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/booking
DATABASE_URL=
PGLITE_DIR=.data/pglite

# REQUIRED in production: random 32+ byte secret for session signing.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional GitHub OAuth (https://github.com/settings/developers).
# Callback URL: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Booking rules
# Minutes a picked slot stays held while the customer confirms (1-30)
HOLD_MINUTES=5
# Holds (slot picks) per user per minute
HOLDS_PER_MINUTE=10

# ---------------------------------------------------------------------------
# AI providers (none required). Without any, the booking assistant and the digest narrative show
# "AI unavailable"; booking, availability and the digest numbers keep working.
# AI_PROVIDER: auto | local | ollama | groq | gemini | huggingface | openai | none
# auto picks the first configured: GROQ_API_KEY, GEMINI_API_KEY, HF_TOKEN,
# OPENAI_API_KEY, OLLAMA_BASE_URL, then AI_LOCAL_MODELS=true.
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
# In-process open model via Transformers.js (downloads ~1.8 GB once to AI_CACHE_DIR; model_q4.onnx is 1,787,566,590 bytes).
AI_LOCAL_MODELS=false
# AI_LOCAL_MODEL=onnx-community/Qwen2.5-1.5B-Instruct
# AI_CACHE_DIR=
# Ollama (https://ollama.com): ollama pull qwen2.5:1.5b
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:1.5b
# Free-tier hosted providers:
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_TOKEN=
# Optional paid / OpenAI-compatible endpoint:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
AI_TIMEOUT_MS=60000

# Limits
# Assistant searches / digests per user (or per IP when signed out) per minute
AI_USER_PER_MINUTE=10
AUTH_SIGNIN_PER_MINUTE=5
