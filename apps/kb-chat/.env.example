# ---------------------------------------------------------------------------
# Cairn (apps/kb-chat) — copy to .env and adjust. Never commit .env.
# Every variable is optional for local development unless marked REQUIRED.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for auth callbacks, emails and Stripe redirects).
APP_URL=http://localhost:3002

# Database. Leave empty to use the embedded PGlite database in .data/pglite (no Docker needed).
# For Postgres (docker-compose, Neon, Supabase) set a connection string:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/kb_chat
DATABASE_URL=
PGLITE_DIR=.data/pglite

# REQUIRED in production: random 32+ byte secret for session signing.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional GitHub OAuth (https://github.com/settings/developers).
# Callback URL: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bearer token for /api/cron/ingest (schedule it every few minutes in production, e.g. Vercel Cron).
CRON_SECRET=

# Upload limit per file in MB (max 50).
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# AI providers (none required). Without any, AI features show "AI unavailable".
# AI_PROVIDER: auto | local | ollama | groq | gemini | huggingface | openai | none
# auto picks the first configured: GROQ_API_KEY, GEMINI_API_KEY, HF_TOKEN,
# OPENAI_API_KEY, OLLAMA_BASE_URL, then AI_LOCAL_MODELS=true.
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
# In-process open models via Transformers.js (downloads ~1.7 GB once to AI_CACHE_DIR).
AI_LOCAL_MODELS=false
# AI_LOCAL_MODEL=onnx-community/Qwen2.5-1.5B-Instruct
# AI_CACHE_DIR=
# Ollama (https://ollama.com): ollama pull qwen2.5:1.5b && ollama pull all-minilm
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:1.5b
# Free-tier hosted providers:
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_TOKEN=
# Optional paid / OpenAI-compatible endpoint:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Embeddings (always all-MiniLM-L6-v2, 384 dims): auto | local | ollama | huggingface | none
AI_EMBED_PROVIDER=auto
AI_TIMEOUT_MS=60000

# Limits (monthly question and document limits are per workspace, stored in the database)
AI_USER_PER_MINUTE=20
WIDGET_PER_MINUTE=6
AUTH_SIGNIN_PER_MINUTE=5
# Test-only: allow URL ingestion from private networks. Never enable in production.
ALLOW_PRIVATE_URLS=false
