{
  "name": "nl-analytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tally: ask questions about your data in plain English. NL-to-SQL with a parser-based read-only guard, charts, saved queries, shareable dashboards and CSV export.",
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build",
    "start": "next start --port 3005",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env drizzle/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env drizzle/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "eval": "tsx --env-file-if-exists=.env scripts/eval-nl-sql.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@portfolio/ai": "*",
    "@portfolio/kit": "*",
    "@portfolio/ui": "*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "libpg-query": "18.1.5",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
