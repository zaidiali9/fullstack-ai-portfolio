# ---------------------------------------------------------------------------
# Tally (apps/nl-analytics) — copy to .env and adjust. Never commit .env.
# Every variable is optional for local development unless marked REQUIRED.
# ---------------------------------------------------------------------------

# Public base URL of the app (auth origin, shared dashboard links). Must match the URL in the browser.
APP_URL=http://localhost:3005

# Database. Leave empty to use the embedded PGlite database in .data/pglite (no Docker needed).
# For Postgres set a connection string. The migration creates the `demo` schema and a NOLOGIN role
# `analytics_reader` (SELECT on demo.* only) and grants it to the migrating user for SET ROLE.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/analytics
DATABASE_URL=
PGLITE_DIR=.data/pglite

# REQUIRED in production: random 32+ byte secret for session signing.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional GitHub OAuth (https://github.com/settings/developers).
# Callback URL: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Limits for user/model SQL (see src/server/sql/execute.ts)
# Per-statement timeout (enforced by Postgres; PGlite relies on the cost ceiling below)
QUERY_TIMEOUT_MS=5000
# Maximum rows returned (results are flagged as truncated beyond this)
QUERY_MAX_ROWS=1000
# EXPLAIN total-cost ceiling; queries estimated above it are refused before running
QUERY_MAX_COST=250000
# Query executions (incl. dashboards and CSV) per user, or per IP for shared links, per minute
QUERIES_PER_MINUTE=60

# ---------------------------------------------------------------------------
# AI providers (none required). Without any, asking in plain English shows "AI unavailable";
# writing SQL by hand, saved queries, dashboards, sharing and CSV keep working.
# AI_PROVIDER: auto | local | ollama | groq | gemini | huggingface | openai | none
# auto picks the first configured: GROQ_API_KEY, GEMINI_API_KEY, HF_TOKEN,
# OPENAI_API_KEY, OLLAMA_BASE_URL, then AI_LOCAL_MODELS=true.
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
# In-process open model via Transformers.js (downloads the model once to AI_CACHE_DIR).
AI_LOCAL_MODELS=false
# AI_LOCAL_MODEL=onnx-community/Qwen2.5-Coder-1.5B-Instruct
# AI_CACHE_DIR=
# Ollama (https://ollama.com): ollama pull qwen2.5-coder:1.5b
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5-coder:1.5b
# Free-tier hosted providers:
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_TOKEN=
# Optional paid / OpenAI-compatible endpoint:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
AI_TIMEOUT_MS=120000

# Limits
# Natural-language questions and summaries per user per minute
AI_USER_PER_MINUTE=10
AUTH_SIGNIN_PER_MINUTE=5
