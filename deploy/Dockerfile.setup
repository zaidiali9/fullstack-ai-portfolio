# syntax=docker/dockerfile:1
# One-off setup job for the Railway deployment: creates the per-app databases and runs migrations + seeds.
# Build from the REPOSITORY ROOT. On Railway: RAILWAY_DOCKERFILE_PATH=deploy/Dockerfile.setup (see deploy/README.md).
FROM node:22-bookworm-slim
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN npm ci --include-workspace-root
CMD ["node", "scripts/railway-setup.mjs"]
